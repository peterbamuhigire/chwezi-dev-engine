{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chwezi.dev/schemas/solution-decision.v1.json",
  "title": "Engineering solution decision",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "scope",
    "context",
    "options",
    "selected_option",
    "evidence",
    "risk",
    "tests"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^SD-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "scope": {
      "type": "object",
      "required": ["root", "files", "sha256"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["problem", "requirements", "invariants"],
      "properties": {
        "problem": {"type": "string", "minLength": 20},
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      },
      "additionalProperties": false
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "description", "reason"],
        "properties": {
          "kind": {"enum": ["no_change", "existing_capability", "stdlib", "native_platform", "installed_dependency", "new_dependency", "original_implementation"]},
          "description": {"type": "string", "minLength": 3},
          "reason": {"type": "string", "minLength": 3}
        },
        "additionalProperties": false
      }
    },
    "selected_option": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "status", "path"],
        "properties": {
          "kind": {"enum": ["repository", "test", "benchmark", "source", "review", "runtime"]},
          "status": {"enum": ["verified", "not_assessed"]},
          "path": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "risk": {
      "type": "object",
      "required": ["tier", "security_boundary", "data_mutation", "money_or_ledger"],
      "properties": {
        "tier": {"enum": ["low", "medium", "high", "critical"]},
        "security_boundary": {"type": "boolean"},
        "data_mutation": {"type": "boolean"},
        "money_or_ledger": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "exception": {
      "type": ["object", "null"],
      "properties": {
        "reason": {"type": "string", "minLength": 10},
        "review_trigger": {"type": "string", "minLength": 10},
        "expires": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": ["required", "negative_cases"],
      "properties": {
        "required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "negative_cases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
